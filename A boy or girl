#include <iostream>
#include <set>
#include <string>

using namespace std;

int main() {
    string username;
    cin >> username;

    // Use a set to store unique characters
    set<char> unique_chars(username.begin(), username.end());

    // Check the size of the set
    if (unique_chars.size() % 2 == 0) {
        cout << "CHAT WITH HER!" << endl;
    } else {
        cout << "IGNORE HIM!" << endl;
    }

    return 0;
}
