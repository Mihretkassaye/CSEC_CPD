#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n, h;
    cin >> n >> h;
    vector<int> friends_heights(n);

    for (int i = 0; i < n; ++i) {
        cin >> friends_heights[i];
    }

    int width = 0;
    for (int height : friends_heights) {
        if (height > h) {
            width += 2; // Friend needs double width
        } else {
            width += 1; // Friend needs single width
        }
    }

    cout << width << endl;
    return 0;
}
