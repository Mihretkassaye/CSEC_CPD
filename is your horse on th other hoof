#include <iostream>
#include <set>
using namespace std;

int main() {
    set<int> horseshoes;
    int color;
    
    // Read the colors of the four horseshoes
    for (int i = 0; i < 4; ++i) {
        cin >> color;
        horseshoes.insert(color);
    }
    
    // The minimum number of additional horseshoes needed
    int additional_horseshoes = 4 - horseshoes.size();
    
    cout << additional_horseshoes << endl;
    
    return 0;
}
