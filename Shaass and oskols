#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;
    cin >> n;
    
    vector<int> birds_on_wire(n);
    for (int i = 0; i < n; ++i) {
        cin >> birds_on_wire[i];
    }
    
    int m;
    cin >> m;
    
    for (int i = 0; i < m; ++i) {
        int wire, position;
        cin >> wire >> position;
        wire--; // Convert to 0-based index
        position--; // Convert to 0-based index

        // Birds fly to neighboring wires
        if (wire > 0) {
            birds_on_wire[wire - 1] += position;
        }
        if (wire < n - 1) {
            birds_on_wire[wire + 1] += birds_on_wire[wire] - position - 1;
        }

        // The current wire has no birds left
        birds_on_wire[wire] = 0;
    }
    
    for (int birds : birds_on_wire) {
        cout << birds << endl;
    }
    
    return 0;
}
